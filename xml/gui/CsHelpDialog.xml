<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<!--
    Crop Stress Field Guide - Field Guide
    5 tabs. Content is built in Lua and swapped per tab (one column pair).
    Chrome copied from SoilGuideDialog so every Realistic Farming guide reads the same.
    Controller: CsHelpDialog
-->
<GUI onOpen="onOpen" onClose="onClose" onCreate="onCreate">
  <GuiElement profile="newLayer"/>
  <Bitmap profile="dialogFullscreenBg" id="dialogBg"/>

  <GuiElement profile="csHelp_bg" id="dialogElement">

    <ThreePartBitmap profile="fs25_dialogBgMiddle"/>
    <ThreePartBitmap profile="fs25_dialogBgTop"/>
    <ThreePartBitmap profile="fs25_dialogBgBottom"/>

    <GuiElement profile="fs25_dialogContentContainer">

      <Text profile="fs25_dialogTitle" id="csHelp_title" text="Crop Stress Field Guide" position="0px -28px"/>

      <BoxLayout profile="csHelp_tabRow" position="0px -66px">
        <Button profile="csHelp_tab" id="csHelp_tab1" text="Overview" onClick="onClickTab1"/>
        <Button profile="csHelp_tab" id="csHelp_tab2" text="HUD and Bands" onClick="onClickTab2"/>
        <Button profile="csHelp_tab" id="csHelp_tab3" text="Crops and Stress" onClick="onClickTab3"/>
        <Button profile="csHelp_tab" id="csHelp_tab4" text="Irrigation" onClick="onClickTab4"/>
        <Button profile="csHelp_tab" id="csHelp_tab5" text="Settings and FAQ" onClick="onClickTab5"/>
      </BoxLayout>

      <Text profile="csHelp_subtitle" id="csHelp_subtitle" text="" position="0px -110px"/>

      <GuiElement profile="csHelp_colPanel" position="-253px -138px">
        <Bitmap profile="csHelp_colBg" position="0px 0px"/>
        <BoxLayout profile="csHelp_col" id="csHelp_col1" position="0px -8px"/>
      </GuiElement>

      <GuiElement profile="csHelp_colPanel" position="253px -138px">
        <Bitmap profile="csHelp_colBgAlt" position="0px 0px"/>
        <BoxLayout profile="csHelp_col" id="csHelp_col2" position="0px -8px"/>
      </GuiElement>

    </GuiElement>

    <BoxLayout profile="fs25_dialogButtonBox">
      <Button profile="buttonOK" text="Close" onClick="onClickClose"/>
    </BoxLayout>

  </GuiElement>

  <GUIProfiles>

    <Profile name="csHelp_bg" extends="fs25_dialogBg">
      <size value="1120px 930px"/>
    </Profile>

    <Profile name="csHelp_tabRow" extends="emptyPanel" with="anchorTopCenter">
      <size value="960px 38px"/>
      <flowDirection value="horizontal"/>
      <elementSpacing value="10px"/>
    </Profile>

    <!-- The guide tabs and Close stay buttonOK: dialog chrome, not Esc overlay chips. -->
    <Profile name="csHelp_tab" extends="buttonOK">
      <size value="174px 36px"/>
      <textSize value="11px"/>
      <textUpperCase value="true"/>
    </Profile>

    <Profile name="csHelp_subtitle" extends="fs25_textDefault" with="anchorTopCenter">
      <size value="960px 22px"/>
      <textSize value="11px"/>
      <textColor value="0.85 0.75 0.30 0.90"/>
      <textAlignment value="center"/>
    </Profile>

    <Profile name="csHelp_colPanel" extends="emptyPanel" with="anchorTopCenter">
      <size value="510px 630px"/>
    </Profile>
    <Profile name="csHelp_colBg" extends="baseReference" with="anchorTopCenter">
      <size value="510px 630px"/>
      <imageColor value="0.08 0.08 0.12 0.90"/>
    </Profile>
    <Profile name="csHelp_colBgAlt" extends="baseReference" with="anchorTopCenter">
      <size value="510px 630px"/>
      <imageColor value="0.06 0.10 0.14 0.90"/>
    </Profile>

    <Profile name="csHelp_col" extends="emptyPanel" with="anchorTopCenter">
      <size value="494px 614px"/>
      <flowDirection value="vertical"/>
      <useFullVisibility value="false"/>
      <alignmentX value="left"/>
      <elementSpacing value="3px"/>
    </Profile>

    <Profile name="csHelp_colHeader" extends="fs25_textDefault" with="anchorTopLeft">
      <size value="472px 22px"/>
      <textSize value="15px"/>
      <textBold value="true"/>
      <textUpperCase value="true"/>
      <textColor value="1 0.8 0.2 1"/>
      <textAlignment value="left"/>
    </Profile>
    <Profile name="csHelp_colBody" extends="fs25_textDefault" with="anchorTopLeft">
      <size value="472px 19px"/>
      <textSize value="14px"/>
      <textColor value="1 1 1 1"/>
      <textAlignment value="left"/>
    </Profile>
    <Profile name="csHelp_colSpacer" extends="fs25_textDefault" with="anchorTopLeft">
      <size value="472px 10px"/>
      <textSize value="8px"/>
      <textColor value="0.0 0.0 0.0 0.0"/>
    </Profile>

  </GUIProfiles>
</GUI>
