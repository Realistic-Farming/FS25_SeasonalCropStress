<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<!--
    CsPDAScreen.xml
    InGameMenu page — Controller: CsPDAScreen (src/ui/CsPDAScreen.lua)
    Pattern: mirrors FS25_MarketDynamics MarketScreen.xml exactly.

    Layout:
      LEFT  (460px) — field list sidebar: F# | Crop | Moisture | Status
      RIGHT (1000px) — tabbed content:
          Tab 1 Overview   → farm-wide moisture & stress stats
          Tab 2 Irrigation → field triage sorted by moisture (driest first)
-->
<GUI name="menuCropStress">
  <GuiElement profile="fs25_menuContainer">

    <!-- ── Header ──────────────────────────────────────────── -->
    <GuiElement profile="fs25_menuHeaderPanel" position="-200px 90px" width="800px">
      <Text profile="fs25_menuHeaderTitle" id="categoryHeaderText"
            text="$l10n_cs_pda_screen_title"/>
    </GuiElement>

    <!-- Two-column layout container (MDM: fs25_subCategorySelectorTabbedContainer) -->
    <GuiElement profile="fs25_subCategorySelectorTabbedContainer" position="0px 0px">

      <!-- ══════════════════════════════════════════════════════
           LEFT COLUMN — 460px field list sidebar
           Coordinate system: Y=0 at TOP of container, negative Y goes down.
           ══════════════════════════════════════════════════════ -->
      <ThreePartBitmap width="460px" height="700px" position="0px 100px">
        <GuiElement profile="fs25_subCategoryContainer" width="420px">

          <!-- Section title -->
          <Text profile="cs_sectionHeader" text="$l10n_cs_pda_tab_fields" position="10px -10px"/>

          <!-- Column headers row -->
          <GuiElement profile="cs_listHeaderRow" position="0px -40px">
            <Text profile="cs_colHeader" text="$l10n_cs_pda_col_field"    position="10px 0px"  size="55px  24px"/>
            <Text profile="cs_colHeader" text="$l10n_cs_pda_col_crop"     position="70px 0px"  size="140px 24px"/>
            <Text profile="cs_colHeader" text="$l10n_cs_pda_col_moisture" position="214px 0px" size="80px  24px"/>
            <Text profile="cs_colHeader" text="$l10n_cs_pda_col_status"   position="298px 0px" size="112px 24px"/>
          </GuiElement>

          <!-- SmoothList -->
          <GuiElement profile="cs_listWrapper" id="fieldListContainer"
                      position="0px -72px" width="420px" height="540px">
            <SmoothList id="fieldList" profile="cs_smoothList"
                        startClipperElementName="sideListStart"
                        endClipperElementName="sideListEnd">
              <ListItem profile="cs_listRow" onClick="onClickFieldRow">
                <Bitmap profile="cs_rowBg" name="alternating"/>
                <Text profile="cs_cellLeft"  name="fieldRowId"       size="55px  30px"/>
                <Text profile="cs_cellLeft"  name="fieldRowCrop"     position="70px  0px" size="140px 30px"/>
                <Text profile="cs_cellRight" name="fieldRowMoisture" position="214px 0px" size="80px  30px"/>
                <Text profile="cs_cellRight" name="fieldRowStatus"   position="298px 0px" size="112px 30px"/>
              </ListItem>
            </SmoothList>
            <Bitmap profile="fs25_secondaryMenuStartClipper" name="sideListStart"/>
            <Bitmap profile="fs25_secondaryMenuStopClipper"  name="sideListEnd"/>
          </GuiElement>

        </GuiElement>
      </ThreePartBitmap>

      <!-- ══════════════════════════════════════════════════════
           RIGHT COLUMN — 1000px tabbed content
           ══════════════════════════════════════════════════════ -->
      <GuiElement id="rightPanel" position="500px 100px" width="1000px" height="700px">

        <!-- ── TAB 1: OVERVIEW ───────────────────────────────
             Labels left-anchored (x=10), values right-anchored (x=730).
             Sections: Fields | Moisture | Stress | Irrigation
             Y negative = down from container top. Row spacing: 30px. -->
        <GuiElement id="overviewContent" position="0px 0px" width="1000px" height="660px">

          <Text profile="cs_sectionHeader"
                text="$l10n_cs_pda_section_farm_overview"
                position="0px 650px"/>
          <Text profile="cs_helpLinkBtn" onClick="onClickCropConsultant"
                position="730px 648px" size="230px 24px" text="CROP CONSULTANT"/>

          <ThreePartBitmap width="960px" height="590px" position="0px 30px">
            <GuiElement profile="fs25_subCategoryContainer" width="920px">

              <!-- ── SECTION: Fields ── -->
              <Text profile="cs_subHeader" text="$l10n_cs_pda_tab_fields"
                    position="10px -10px"/>

              <Text profile="cs_statLabel" text="$l10n_cs_pda_fields_tracked"
                    position="10px -38px" size="600px 26px"/>
              <Text profile="cs_statValue" id="statsFieldsTracked" text="0"
                    position="730px -38px" size="160px 26px"/>

              <Text profile="cs_statLabel" text="$l10n_cs_pda_fields_owned"
                    position="10px -68px" size="600px 26px"/>
              <Text profile="cs_statValue" id="statsFieldsOwned" text="0"
                    position="730px -68px" size="160px 26px"/>

              <Bitmap profile="cs_sectionDivider" position="10px -100px" size="880px 1px"/>

              <!-- ── SECTION: Moisture ── -->
              <Text profile="cs_subHeader" text="$l10n_cs_pda_section_moisture"
                    position="10px -115px"/>

              <Text profile="cs_statLabel" text="$l10n_cs_pda_avg_moisture"
                    position="10px -143px" size="600px 26px"/>
              <Text profile="cs_statValue" id="statsAvgMoisture" text="—"
                    position="730px -143px" size="160px 26px"/>

              <Text profile="cs_statLabel" text="$l10n_cs_pda_fields_healthy"
                    position="10px -173px" size="600px 26px"/>
              <Text profile="cs_statValue" id="statsHealthy" text="0"
                    position="730px -173px" size="160px 26px"/>

              <Text profile="cs_statLabel" text="$l10n_cs_pda_fields_warning"
                    position="10px -203px" size="600px 26px"/>
              <Text profile="cs_statValue" id="statsWarning" text="0"
                    position="730px -203px" size="160px 26px"/>

              <Text profile="cs_statLabel" text="$l10n_cs_pda_fields_critical"
                    position="10px -233px" size="600px 26px"/>
              <Text profile="cs_statValue" id="statsCritical" text="0"
                    position="730px -233px" size="160px 26px"/>

              <Bitmap profile="cs_sectionDivider" position="10px -265px" size="880px 1px"/>

              <!-- ── SECTION: Stress ── -->
              <Text profile="cs_subHeader" text="$l10n_cs_pda_section_stress"
                    position="10px -280px"/>

              <Text profile="cs_statLabel" text="$l10n_cs_pda_avg_stress"
                    position="10px -308px" size="600px 26px"/>
              <Text profile="cs_statValue" id="statsAvgStress" text="—"
                    position="730px -308px" size="160px 26px"/>

              <Text profile="cs_statLabel" text="$l10n_cs_pda_est_yield_loss"
                    position="10px -338px" size="600px 26px"/>
              <Text profile="cs_statValue" id="statsYieldLoss" text="—"
                    position="730px -338px" size="160px 26px"/>

              <Bitmap profile="cs_sectionDivider" position="10px -370px" size="880px 1px"/>

              <!-- ── SECTION: Irrigation ── -->
              <Text profile="cs_subHeader" text="$l10n_cs_pda_section_irrigation"
                    position="10px -385px"/>

              <Text profile="cs_statLabel" text="$l10n_cs_pda_irrigated_fields"
                    position="10px -413px" size="600px 26px"/>
              <Text profile="cs_statValue" id="statsIrrigated" text="0"
                    position="730px -413px" size="160px 26px"/>

              <Text profile="cs_statLabel" text="$l10n_cs_pda_irrigation_systems"
                    position="10px -443px" size="600px 26px"/>
              <Text profile="cs_statValue" id="statsIrrSystems" text="0"
                    position="730px -443px" size="160px 26px"/>

            </GuiElement>
          </ThreePartBitmap>

          <Text profile="cs_emptyHint" id="overviewEmptyHint"
                text="$l10n_cs_pda_no_fields"
                position="480px 320px" visible="false"/>

        </GuiElement><!-- /overviewContent -->

        <!-- ── TAB 2: IRRIGATION ─────────────────────────────
             Hidden by default. Column widths spread across 960px. -->
        <GuiElement id="irrigationContent" position="0px 0px" width="1000px" height="660px" visible="false">

          <Text profile="cs_sectionHeader"
                text="$l10n_cs_pda_section_irrigation_plan"
                position="0px 650px"/>
          <Text profile="cs_helpLinkBtn" onClick="onClickCropConsultant"
                position="730px 648px" size="230px 24px" text="CROP CONSULTANT"/>

          <!-- Column headers -->
          <Text profile="cs_colHeader" text="$l10n_cs_pda_col_field"
                position="8px  618px" size="72px 24px"/>
          <Text profile="cs_colHeader" text="$l10n_cs_pda_col_crop"
                position="84px 618px" size="300px 24px"/>
          <Text profile="cs_colHeader" text="$l10n_cs_pda_col_moisture"
                position="388px 618px" size="110px 24px"/>
          <Text profile="cs_colHeader" text="$l10n_cs_pda_col_stress"
                position="502px 618px" size="110px 24px"/>
          <Text profile="cs_colHeader" text="$l10n_cs_pda_col_irrigated"
                position="616px 618px" size="140px 24px"/>

          <!-- Separator below column headers -->
          <Bitmap profile="cs_separatorH" position="0px 592px" size="960px 1px"/>

          <!-- Irrigation triage list -->
          <GuiElement id="irrigationListContainer" position="0px 80px" width="960px" height="520px">
            <SmoothList id="irrigationList" profile="cs_smoothList"
                        startClipperElementName="irrListStart"
                        endClipperElementName="irrListEnd">
              <ListItem profile="cs_listRow" onClick="onClickIrrigationRow">
                <Bitmap profile="cs_rowBg" name="alternating"/>
                <Text profile="cs_cellLeft"  name="irrRowId"        size="72px  30px"/>
                <Text profile="cs_cellLeft"  name="irrRowCrop"      position="84px  0px" size="300px 30px"/>
                <Text profile="cs_cellRight" name="irrRowMoisture"  position="388px 0px" size="110px 30px"/>
                <Text profile="cs_cellRight" name="irrRowStress"    position="502px 0px" size="110px 30px"/>
                <Text profile="cs_cellRight" name="irrRowIrrigated" position="616px 0px" size="140px 30px"/>
              </ListItem>
            </SmoothList>
            <Bitmap profile="fs25_secondaryMenuStartClipper" name="irrListStart"/>
            <Bitmap profile="fs25_secondaryMenuStopClipper"  name="irrListEnd"/>
          </GuiElement>

          <Text profile="cs_emptyHint" id="irrigationEmptyHint"
                text="$l10n_cs_pda_no_fields"
                position="480px 320px" visible="false"/>

        </GuiElement><!-- /irrigationContent -->

        <!-- ── Tab bar — LAST for mouse event priority (MDM pattern) ──
             FS25 processes mouse events in reverse XML order.
             Tab bar must be last so it gets click priority over content panels. -->
        <GuiElement id="tabBar" profile="emptyPanel" position="0px 660px" width="1000px" height="30px">
          <!-- Invisible hit areas -->
          <Button profile="cs_tabBtnHit" onClick="onClickTabOverview"
                  position="0px 0px" size="490px 28px"/>
          <Button profile="cs_tabBtnHit" onClick="onClickTabIrrigation"
                  position="510px 0px" size="490px 28px"/>
          <!-- Visible labels (color driven by Lua) -->
          <Text profile="cs_tabLabel" id="tabLabelOverview"
                text="$l10n_cs_pda_tab_overview"
                position="0px 28px" size="490px 28px"
                onClick="onClickTabOverview"/>
          <Text profile="cs_tabLabel" id="tabLabelIrrigation"
                text="$l10n_cs_pda_tab_irrigation"
                position="510px 28px" size="490px 28px"
                onClick="onClickTabIrrigation"/>
          <!-- Always-visible dim underlines (inactive-state affordance) -->
          <Bitmap profile="cs_tabUnderlineDim" position="0px 0px" size="490px 2px"/>
          <Bitmap profile="cs_tabUnderlineDim" position="510px 0px" size="490px 2px"/>
          <!-- Active underlines (toggled by Lua) — render on top of dim -->
          <Bitmap profile="cs_tabUnderline" id="tabUnderlineOverview"
                  position="0px 0px" size="490px 2px"/>
          <Bitmap profile="cs_tabUnderline" id="tabUnderlineIrrigation"
                  position="510px 0px" size="490px 2px" visible="false"/>
        </GuiElement>

        <Bitmap profile="cs_tabDivider" position="0px 658px" size="1000px 2px"/>

      </GuiElement><!-- /rightPanel -->

    </GuiElement><!-- /subCategorySelectorTabbedContainer -->

  </GuiElement><!-- /menuContainer -->

  <!-- ── Inline profile definitions ──────────────────────── -->
  <GUIProfiles>

    <!-- Invisible tab hit area -->
    <Profile name="cs_tabBtnHit" extends="emptyPanel">
      <isFocusable value="true"/>
    </Profile>

    <!-- Tab label — color is Lua-driven (active=white, inactive=dim) -->
    <Profile name="cs_tabLabel" extends="fs25_textDefault" with="anchorTopLeft">
      <isFocusable value="true"/>
      <textSize value="15px"/>
      <textBold value="true"/>
      <textUpperCase value="true"/>
      <textAlignment value="center"/>
    </Profile>

    <!-- Active tab underline (teal) -->
    <Profile name="cs_tabUnderline" extends="baseReference" with="anchorBottomLeft">
      <imageColor value="0.20 0.65 0.85 1.0"/>
    </Profile>

    <!-- Inactive tab underline (always visible, dim) -->
    <Profile name="cs_tabUnderlineDim" extends="baseReference" with="anchorBottomLeft">
      <imageColor value="1.0 1.0 1.0 0.18"/>
    </Profile>

    <!-- Full-width hairline below tab bar -->
    <Profile name="cs_tabDivider" extends="baseReference" with="anchorTopLeft">
      <imageColor value="1.0 1.0 1.0 0.12"/>
    </Profile>

    <!-- Section header (large, teal) -->
    <Profile name="cs_sectionHeader" extends="fs25_textDefault" with="anchorTopLeft">
      <textSize value="18px"/>
      <textBold value="true"/>
      <textUpperCase value="true"/>
      <textColor value="0.20 0.65 0.85 1.0"/>
    </Profile>

    <!-- Sub-section header (small caps, dim teal) -->
    <Profile name="cs_subHeader" extends="fs25_textDefault" with="anchorTopLeft">
      <textSize value="13px"/>
      <textBold value="true"/>
      <textUpperCase value="true"/>
      <textColor value="0.20 0.65 0.85 0.68"/>
    </Profile>

    <!-- Stat label (left-aligned, 50% white) -->
    <Profile name="cs_statLabel" extends="fs25_textDefault" with="anchorTopLeft">
      <textSize value="14px"/>
      <textColor value="$preset_colorWhite_50"/>
      <textAlignment value="left"/>
      <size value="600px 26px"/>
    </Profile>

    <!-- Stat value (right-aligned, full white, bold) -->
    <Profile name="cs_statValue" extends="fs25_textDefault" with="anchorTopLeft">
      <textSize value="14px"/>
      <textBold value="true"/>
      <textColor value="$preset_colorWhite"/>
      <textAlignment value="right"/>
      <size value="160px 26px"/>
    </Profile>

    <!-- Column header row container -->
    <Profile name="cs_listHeaderRow" extends="emptyPanel" with="anchorTopStretchingX">
      <height value="24px"/>
    </Profile>

    <!-- Column header text -->
    <Profile name="cs_colHeader" extends="fs25_textDefault" with="anchorTopLeft">
      <textSize value="12px"/>
      <textBold value="true"/>
      <textUpperCase value="true"/>
      <textColor value="$preset_colorWhite_50"/>
      <textAlignment value="left"/>
    </Profile>

    <!-- Hairline below column headers (slightly brighter) -->
    <Profile name="cs_separatorH" extends="baseReference" with="anchorTopLeft">
      <imageColor value="1.0 1.0 1.0 0.15"/>
    </Profile>

    <!-- Section divider within overview stats (subtle) -->
    <Profile name="cs_sectionDivider" extends="baseReference" with="anchorTopLeft">
      <imageColor value="1.0 1.0 1.0 0.08"/>
    </Profile>

    <!-- anchorTopLeft wrapper so SmoothList position= is top-relative -->
    <Profile name="cs_listWrapper" extends="emptyPanel" with="anchorTopLeft"/>

    <Profile name="cs_smoothList" extends="emptyPanel" with="anchorStretchingYLeft pivotTopLeft"/>

    <Profile name="cs_listRow" extends="emptyPanel" with="anchorTopStretchingX pivotTopLeft">
      <height value="30px"/>
    </Profile>

    <Profile name="cs_rowBg" extends="baseReference" with="anchorStretchingYStretchingX">
      <imageColor value="$preset_fs25_colorGrey"/>
      <imageSelectedColor value="0.10 0.35 0.55 0.85"/>
      <alternateBackgroundColor value="$preset_fs25_colorGreyDark_50"/>
    </Profile>

    <Profile name="cs_cellLeft" extends="fs25_textDefault" with="anchorStretchingYLeft">
      <position value="8px 0px"/>
      <textSize value="13px"/>
      <textAlignment value="left"/>
      <textColor value="$preset_fs25_colorMainLight"/>
      <textSelectedColor value="$preset_fs25_colorMainDark"/>
    </Profile>

    <Profile name="cs_cellRight" extends="cs_cellLeft">
      <textAlignment value="right"/>
    </Profile>

    <!-- Ownership filter toggle (sidebar header, right side) — teal so it's clearly visible -->
    <Profile name="cs_filterBtn" extends="fs25_textDefault" with="anchorTopLeft">
      <isFocusable value="true"/>
      <textSize value="13px"/>
      <textBold value="true"/>
      <textUpperCase value="true"/>
      <textAlignment value="right"/>
      <textColor value="0.20 0.65 0.85 1.0"/>
    </Profile>

    <!-- Inline Help link (top-right of right panel) -->
    <Profile name="cs_helpLinkBtn" extends="fs25_textDefault" with="anchorTopLeft">
      <isFocusable value="true"/>
      <textSize value="12px"/>
      <textBold value="true"/>
      <textUpperCase value="true"/>
      <textAlignment value="right"/>
      <textColor value="0.20 0.65 0.85 0.75"/>
    </Profile>

    <Profile name="cs_emptyHint" extends="fs25_textDefault" with="anchorTopLeft">
      <textSize value="14px"/>
      <textAlignment value="center"/>
      <textColor value="$preset_colorWhite_50"/>
    </Profile>

  </GUIProfiles>

</GUI>
