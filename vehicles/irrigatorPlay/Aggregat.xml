    <!-- BUILD 18:08 - SPS conduit embed. Inert without SPS: Giants ignores unknown
         children of <vehicle>, and nothing in SCS reads this block. The pump station
         semantics George asked for (transfer between chains) rather than a second
         infinite field nurse. selfPowered is false because its only documented effect
         is loading <sounds><engineLoop>, which this kit does not ship. -->
    <slurryPipeSystem>
        <nodeTree filename="i3d/sps_nodes_Aggregat.i3d"/>
        <pump pumpType="conduit" selfPowered="false"/>
        <flow litersPerSecond="120"/>
        <pipeCouplings>
            <pipeCoupling id="1" mountNodeName="SPS_pipeCouplerAgg01" valveType="MANUAL"
                          flowDirection="BOTH" maxPipeLength="8.0" fillUnitIndex="1" connector="male"/>
            <pipeCoupling id="2" mountNodeName="SPS_pipeCouplerAgg02" valveType="MANUAL"
                          flowDirection="BOTH" maxPipeLength="8.0" fillUnitIndex="1" connector="male"/>
        </pipeCouplings>
    </slurryPipeSystem>
