	<animations>
        <animation name="folding">
            <!-- Arbeitsmodus: Regnerwagen bis 220 m frei beweglich. Transportmodus: Gelenk wird an der Trommel verriegelt. -->
            <!-- BUILD 21:13: rigid lock from 21:01 undone. AutoReel needs joint 1 to open
                 to 220 m in Workmode; locking it at 0 was the stopgap that stopped the
                 gun being left behind, and it contradicts the reel workflow. Keyframes
                 restored to the RWSM source values. Transport spawn is unchanged. -->
            <part startTime="0" endTime="1" componentJointIndex="1" startRotLimit="180 180 180" endRotLimit="0 0 0" startTransLimit="220 220 220" endTransLimit="0 0 0"/>
			<!--<part startTime="2" endTime="5" componentJointIndex="1" startRotLimit="0 0 40" endRotLimit="0 0 0" startTransLimit="0.3 0.3 0.3" endTransLimit="0 0 0"/>-->

			<part node="Abschaltung_rot" startTime="2" endTime="5" startRot="0 0 43" endRot="0 0 0" />
			<part node="compJoint" startTime="2" endTime="5" startRot="0 0 -43" endRot="0 0 0" />
			<part node="Stuetzen_vis" startTime="5" endTime="10" startTrans="-1.615 -0.189 0" endTrans="-1.189 0.106 0" />
        </animation>
		
		<!-- LS19-Einzug: native Gelenkgrenzen-Animation -->

		
		<animation name="hoseReelLS19">
        <part startTime="0" endTime="26400"

		
		          componentJointIndex="1"

		
		          startTransLimit="220 220 220"

		
		          endTransLimit="0 220 0"/>

		
		</animation>

		
		<animation name="sprayAnim" looping="true">
            <part node="Pendel_vis" startTime="0" endTime="0.3" startRot="0 0 -25" endRot="0 0 0"/>
            <part node="Pendel_vis" startTime="0.30001" endTime="1" startRot="0 0 0" endRot="0 0 -25"/>
        </animation>
        <animation name="regnerSweepAnim" looping="true">
            <!-- Approx. 220 degree part-circle rotation around the vertical pivot. -->
            <!-- The cycle starts at the model's original 90 degree heading to avoid a jump. -->
            <!-- Approx. 2.2 degrees/second: deliberately slow, smooth field calibration. -->
            <part node="Regner_vis" startTime="0" endTime="50" startRot="0 90 0" endRot="0 200 0"/>
            <part node="Regner_vis" startTime="50.0001" endTime="150" startRot="0 200 0" endRot="0 -20 0"/>
            <part node="Regner_vis" startTime="150.0001" endTime="200" startRot="0 -20 0" endRot="0 90 0"/>
        </animation>
		<animation name="moveSupport">
            <part node="Support_vis" startTime="0" endTime="1" startTrans="0.83 -0.117 0" endTrans="0.83 -0.343 0" />
			<part node="Kurbel_vis" startTime="0" endTime="1" startRot="0 720 0" endRot="0 0 0" />
        </animation>
    </animations>
	
