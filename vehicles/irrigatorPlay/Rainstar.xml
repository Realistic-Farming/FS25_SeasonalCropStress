    <!-- BUILD 22:25: turnOffIfNotAllowed flipped to true. TurnOnVehicle:onUpdateTick
         already turns a vehicle off under this flag when getCanBeTurnedOn goes false,
         server-side and keyed on getIsPowered, so pulling the hose or stopping the pump
         now stops the spray on Giants' own tick. No bespoke tick, nothing to fence
         against thrash. turnedOnByAttacherVehicle stays false: the pump is the power
         source, not the tow vehicle.
         BUILD 22:29: turnOffOnDeactivate=false so leave-tractor / deactivateAttachments
         does not kill spray. onPreDetach still turns off (Giants, unconditional). -->
    <turnOnVehicle turnOffIfNotAllowed="true" turnOffOnDeactivate="false" turnedOnByAttacherVehicle="false" requiresMotorTurnOn="false" needsSelection="false">
        <turnedOnAnimation name="sprayAnim" speedScale="1" turnOnFadeTime="0.05" turnOffFadeTime="0.15"/>
        <turnedOnAnimation name="regnerSweepAnim" speedScale="1" turnOnFadeTime="0.5" turnOffFadeTime="0.5"/>
        <!-- BUILD 17:16: belt WASHER on TurnOn so gun water shows even if sprayer workArea is quiet. -->
        <effects>
            <effectNode effectNode="effectMesh" materialType="WASHER" materialTypeId="1" delay="0" fadeTime="0.15"/>
        </effects>
        <sounds>
            <start file="vehicles/irrigatorPlay/sounds/sprinkler_start.ogg" linkNode="PendelCol" innerRadius="8" outerRadius="85">
                <volume indoor="0.25" outdoor="0.9"/>
            </start>
            <work file="vehicles/irrigatorPlay/sounds/sprinkler_work.ogg" linkNode="PendelCol" innerRadius="12" outerRadius="130">
                <volume indoor="0.28" outdoor="1.0"/>
            </work>
            <stop file="vehicles/irrigatorPlay/sounds/sprinkler_stop.ogg" linkNode="PendelCol" innerRadius="8" outerRadius="85">
                <volume indoor="0.22" outdoor="0.85"/>
            </stop>
        </sounds>
    </turnOnVehicle>

