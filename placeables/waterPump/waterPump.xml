<?xml version="1.0" encoding="utf-8"?>
<!--
    waterPump.xml
    Placeable type declaration for the water pump.
    The Lua class (WaterPump) is registered via modDesc.xml <placeableTypes>.
    This file is referenced by modDesc.xml storeItem filename.
-->
<placeable type="waterPump" descVersion="105">

    <storeData>
        <name>$l10n_cs_pump_name</name>
        <image>$data/placeables/brandless/waterTanks/level02/store_waterTankLevel02.dds</image>
        <functions>
            <function>$l10n_cs_pump_function</function>
        </functions>
        <price>12000</price>
        <dailyUpkeep>5</dailyUpkeep>
        <canBeSold>true</canBeSold>
        <showInStore>true</showInStore>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>NONE</brand>
        <species>PLACEABLE</species>
        <category>waterTanks</category>
        <brush>
            <type>placeable</type>
            <category>buildings</category>
            <tab>tools</tab>
        </brush>
    </storeData>

    <!--
        The water pump wears a real water tank model. The base-game level02 tank
        is referenced directly (the $data pattern, same as the store image) so the
        mod stays lean; the WaterPump specialization still registers as an SCS
        water source. Placement areas come from the tank i3d's own node layout.
    -->
    <base>
        <filename>$data/placeables/brandless/waterTanks/level02/waterTankLevel02.i3d</filename>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true">
        <testAreas>
            <testArea startNode="testAreaStart01" endNode="testAreaEnd01" />
        </testAreas>
        <sounds>
            <place template="smallImp"/>
        </sounds>
    </placement>

    <!--
        These sections are optional in FS25 but their absence generates log warnings.
        Providing empty/minimal entries suppresses them cleanly.
    -->
    <clearAreas/>
    <indoorAreas/>
    <aiUpdateAreas/>
    <levelingAreas/>

    <i3dMappings>
        <i3dMapping id="testAreaStart01" node="0>3|0" />
        <i3dMapping id="testAreaEnd01"   node="0>3|0|0" />
    </i3dMappings>

    <!-- Custom pump parameters — read by WaterPump:onLoad() via getXMLFloat -->
    <pumpConfig
        waterFlowCapacity="1000"
    />

</placeable>