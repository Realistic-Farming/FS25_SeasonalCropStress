<?xml version="1.0" encoding="utf-8"?>
<!--
    Reinke A22 — 3-tower variant (~115 m radius).
    Bound to the FS25_ReinkeA22 mod's reinkeIrrigationPivot placeable type.
-->
<placeable type="reinkeIrrigationPivot" descVersion="105">

    <storeData>
        <name>$l10n_reinke_pivot_3_name</name>
        <image>placeables/reinkeA22/store_Reinke3.dds</image>
        <functions>
            <function>$l10n_reinke_pivot_function</function>
        </functions>
        <price>1</price>
        <dailyUpkeep>15</dailyUpkeep>
        <canBeSold>true</canBeSold>
        <showInStore>true</showInStore>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>NONE</brand>
        <species>PLACEABLE</species>
        <category>placeableMisc</category>
        <brush>
            <type>placeable</type>
            <category>buildings</category>
            <tab>tools</tab>
        </brush>
    </storeData>

    <base>
        <filename>placeables/reinkeA22/Reinke_Pivot_3.i3d</filename>
        <canBeRenamed>true</canBeRenamed>
        <boughtWithFarmland>true</boughtWithFarmland>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true">
        <sounds>
            <place file="$data/sounds/placeables/placeImpacts/placeLargeImpact_01.ogg" innerRadius="5" outerRadius="25" volumeScale="0.80" />
        </sounds>
        <!-- TODO(GE): add a "TestArea" TransformGroup under XML (index 2, alongside
             AIupdate=0 and Leveling=1) with Start/End child nodes, then point these at it. -->
        <testAreas>
            <testArea startNode="0>3|2|0" endNode="0>3|2|1" />
        </testAreas>
    </placement>

    <!-- clearAreas covers the center tower base (concrete pad footprint only).
         Nodes 0>3|1|0/1/2 must be positioned tightly around the base in GE —
         if the stripe reappears, check those node world positions in GE. -->
    <clearAreas>
        <clearArea startNode="0>3|1|0" widthNode="0>3|1|1" heightNode="0>3|1|2" />
    </clearAreas>

    <indoorAreas />

    <ai>
        <updateAreas>
            <updateArea startNode="0>3|0|0" endNode="0>3|0|1" />
        </updateAreas>
    </ai>

    <!-- <leveling requireLeveling="true" maxSlope="20" realignAfterLeveling="true" maxEdgeAngle="20" maxSmoothDistance="3" > -->
    <leveling>
        <paintAreas>
            <!-- <paintArea startNode="0>3|1|0"
                heightNode="0>3|1|2"
                groundType="string"
                widthNode="0>3|1|1"
            /> -->
        </paintAreas>
        <levelAreas>
            <levelArea heightNode="0>3|1|2"
                widthNode="0>3|1|1"
                startNode="0>3|1|0"
                groundType="DIRT"
            />
        </levelAreas>
    </leveling>

